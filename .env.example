# compose.yaml(開発用DB)の設定の見本
# このファイルを .env という名前でコピーし、パスワードを設定する(.env はGitHubに上げない)
POSTGRES_USER=rag
POSTGRES_DB=ragdb
POSTGRES_PASSWORD=

# pgAdmin(docker compose --profile tools up -d で起動する管理ツール)
# (デスクトップモードで起動するため、ログインには使わない。未設定でも動く)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=
